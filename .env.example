# Copy this file to .env.local for local development
ENABLE_PLACEMENT_CREATE=false
NEXT_PUBLIC_ENABLE_PLACEMENT_CREATE=false
ENABLE_CREATE_CSV=false
ENABLE_PLACEMENT_DELETE=false
NEXT_PUBLIC_ENABLE_PLACEMENT_DELETE=false

# For local development, you may want to enable:
# ENABLE_PLACEMENT_CREATE=true
# NEXT_PUBLIC_ENABLE_PLACEMENT_CREATE=true
# ENABLE_CREATE_CSV=true
# ENABLE_PLACEMENT_DELETE=true
# NEXT_PUBLIC_ENABLE_PLACEMENT_DELETE=true